{"$id":"creature-engine/style.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"boil":{"additionalProperties":false,"description":"Authored line boil. Per the cartoon-craft skill: a user decision, never inherited silently; applied in the render layer only, never baked into a corpus.","properties":{"amplitude_cells":{"maximum":1,"type":"number"},"enabled":{"default":false,"type":"boolean"},"max_rate_hz":{"type":"number"},"note":{"type":"string"}},"required":["enabled"],"type":"object"},"display_name":{"type":"string"},"id":{"pattern":"^[a-z0-9][a-z0-9-]*$","type":"string"},"principles":{"items":{"type":"string"},"type":"array"},"qa_checks":{"additionalProperties":false,"description":"Craft checks as PLUGGABLE VALIDATORS: the style pack names which checks run and with what thresholds; the engine owns the measuring code. New craft knowledge = new validator + a line here, never an engine fork.","properties":{"id":{"description":"Validator id registered in the engine QA harness (engine/qa.py).","type":"string"},"params":{"type":"object"},"severity":{"default":"gate","enum":["gate","warn","info"],"type":"string"}},"required":["id"],"type":"array"},"render_rules":{"additionalProperties":false,"properties":{"aa_halo":{"default":"forbidden","enum":["forbidden","allowed"],"type":"string"},"dithering":{"default":"forbidden","enum":["forbidden","allowed"],"type":"string"},"downsample":{"default":"majority","enum":["majority","area"],"type":"string"},"gradients":{"default":"forbidden","enum":["forbidden","allowed"],"type":"string"},"interior_detail_max_features":{"type":"integer"},"outline":{"default":"value-contrast","enum":["value-contrast","drawn","none"],"type":"string"},"supersample":{"default":4,"minimum":1,"type":"integer"}},"type":"object"},"schema_version":{"const":1},"skill_ref":{"description":"Path to the craft skill document this pack operationalizes.","type":"string"}},"required":["schema_version","id","display_name","qa_checks"],"title":"Style pack (creature-engine v1)","type":"object"}